[Unit]
Description=Weekly TaskFlow stale image prune
Documentation=https://github.com/mehdi-rochereau/taskflow-deploy

[Timer]
# Sunday 04:00 UTC. The host runs on UTC, so this is unambiguous and immune to
# daylight saving shifts. An hour after the daily backup, which finishes in
# seconds, so the two never overlap in practice.
#
# Weekly and not daily: images accumulate one per deployment, and deployments
# are measured in a handful per week. A daily run would do nothing six days out
# of seven.
OnCalendar=Sun *-*-* 04:00:00 UTC

# Spreads the start over five minutes so the job does not collide with the
# Certbot timer and Ubuntu's own scheduled tasks, all of which fire on the hour.
# Matters on a two-vCPU host.
RandomizedDelaySec=300

# Runs the job on next boot if the scheduled time was missed while the VPS was
# down. Without this, an outage over Sunday 04:00 skips a full week.
Persistent=true

# Explicit rather than implied by the filename. Renaming one file without the
# other would otherwise break the link silently.
Unit=taskflow-prune.service

[Install]
WantedBy=timers.target