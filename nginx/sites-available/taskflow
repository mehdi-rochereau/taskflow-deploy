# Reverse proxy for the TaskFlow frontend.
#
# taskflow.mehdi-rochereau.dev -> taskflow-ui container on 127.0.0.1:4000
#
# This file is versioned in taskflow-deploy under nginx/sites-available/.
# Edit it there, never directly on the VPS: /opt/taskflow is a Git working copy
# and the CD pipelines run git pull --ff-only, which fails on a local edit.

# ── HTTPS ────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    server_name taskflow.mehdi-rochereau.dev;

    # http2 as a listen parameter and not the http2 directive. The directive
    # appeared in nginx 1.25.1, and that same version deprecated this
    # parameter. This server runs 1.24.0 from the Ubuntu 24.04 repositories,
    # where http2 on; fails with unknown directive. Swap the two at a future
    # Ubuntu upgrade, not before.
    #
    # HTTP/2 multiplexes requests over one connection. A production Angular
    # build loads twenty-one resources on a project page, all of them over
    # HTTP/1.1 before this change, against a browser limit of six connections
    # per origin.

    include snippets/taskflow-tls.conf;
    include snippets/taskflow-security-headers.conf;

    location / {
        # 127.0.0.1 and not localhost. /etc/hosts maps localhost to both
        # 127.0.0.1 and ::1, and Nginx resolves it at configuration load,
        # keeping both. The container is published on 127.0.0.1 only, so every
        # proxied request tried ::1 first, took a TCP refusal, and fell back to
        # IPv4. It worked, and wrote a connect() failed line to the error log
        # each time: 112 of them in half a day. An error log has to contain
        # nothing but errors to be read at all. See issue #49.
        proxy_pass http://127.0.0.1:4000;
        include snippets/taskflow-proxy.conf;
    }
}

# ── HTTP ─────────────────────────────────────────────────────────────────────
server {
    listen 80;
    server_name taskflow.mehdi-rochereau.dev;

    include snippets/taskflow-acme.conf;

    # Everything else is redirected to HTTPS. 301 and not 302: the redirect is
    # permanent and browsers may cache it, which is the intent.
    #
    # This replaces the if block Certbot generated. An if at server level is
    # evaluated in the rewrite phase, therefore before any location is
    # selected, and captured the ACME challenge too.
    location / {
        return 301 https://$host$request_uri;
    }
}