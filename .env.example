# .env.example — TaskFlow production environment template
# Copy this file to .env and fill in real values before deploying.
# This file IS committed to the repository — it contains no secrets.

# ── Database ───────────────────────────────────────────────
# MYSQL_ROOT_PASSWORD is deliberately absent. Since issue #20 the database reads
# its passwords from Docker Compose secrets, files under /home/mehdi/secrets/
# created during setup. See step 5 of Initial Server Setup in README.md.

DB_HOST=taskflow-db
DB_PORT=3306
DB_NAME=taskflow
DB_USERNAME=change-this-username
DB_PASSWORD=change-this-password

# ── JWT ────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 64
JWT_SECRET=change-this-secret-must-be-at-least-32-characters-long
JWT_EXPIRATION=900000

# ── Cookies ────────────────────────────────────────────────
# Must be true in production — cookies only sent over HTTPS
COOKIE_SECURE=true

# ── CORS ───────────────────────────────────────────────────
# Origins allowed to call the API, comma-separated. Required by taskflow-api
# in production: without it the UI is served but every request is rejected.
CORS_ALLOWED_ORIGINS=https://taskflow.your-domain.example

# ── Refresh token ──────────────────────────────────────────
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ── Backups ────────────────────────────────────────────────
# ntfy topic used by scripts/backup-db.sh to report backup failures.
# Treat as a secret: anyone who knows the name can read and post to it.
# Generate a long random name, subscribe to it in the ntfy mobile app.
NTFY_TOPIC=change-this-to-a-long-random-topic-name