# .env.example — TaskFlow production environment template
# Copy this file to .env and fill in real values before deploying.
# This file IS committed to the repository — it contains no secrets.

# ── Database ───────────────────────────────────────────────
# Root password for MySQL — used internally by the container only
MYSQL_ROOT_PASSWORD=change-this-root-password

DB_HOST=taskflow-db
DB_PORT=3306
DB_NAME=taskflow
DB_USERNAME=change-this-username
DB_PASSWORD=change-this-password

# ── JWT ────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 64
JWT_SECRET=change-this-secret-must-be-at-least-32-characters-long
JWT_EXPIRATION=900000

# ── Cookies ────────────────────────────────────────────────
# Must be true in production — cookies only sent over HTTPS
COOKIE_SECURE=true

# ── Refresh token ──────────────────────────────────────────
REFRESH_TOKEN_EXPIRATION_DAYS=7