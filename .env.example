# .env.example — TaskFlow production environment template
# Copy this file to .env and fill in real values before deploying.
# This file IS committed to the repository — it contains no secrets.

# ── Database ───────────────────────────────────────────────
# MYSQL_ROOT_PASSWORD and DB_PASSWORD are deliberately absent. Since #20 for the
# first and #38 for the second, both are read from Docker Compose secrets, files
# under /home/mehdi/secrets/ created during setup. This file therefore holds no
# database password at all, and none has to be kept in sync with anything.
# See step 5 of Initial Server Setup in README.md.
#
# DB_USERNAME stays here on purpose: an account name is not a credential, and the
# same value feeds MYSQL_USER on taskflow-db, so a single source prevents drift.

DB_HOST=taskflow-db
DB_PORT=3306
DB_NAME=taskflow
DB_USERNAME=change-this-username

# ── JWT ────────────────────────────────────────────────────
# JWT_SECRET is deliberately absent since #38. It is a Docker Compose secret,
# file /home/mehdi/secrets/jwt_secret, created during setup with
# `openssl rand -hex 64`. See step 5 of Initial Server Setup in README.md.
JWT_EXPIRATION=900000

# ── Cookies ────────────────────────────────────────────────
# Must be true in production — cookies only sent over HTTPS
COOKIE_SECURE=true

# ── CORS ───────────────────────────────────────────────────
# Origins allowed to call the API, comma-separated. Required by taskflow-api
# in production: without it the UI is served but every request is rejected.
# The API's own origin has to be listed too: the Swagger UI is served from it
# and the browser treats its calls as cross-origin requests.
CORS_ALLOWED_ORIGINS=https://taskflow.your-domain.example,https://api.taskflow.your-domain.example

# ── Refresh token ──────────────────────────────────────────
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ── Backups ────────────────────────────────────────────────
# ntfy topic used by scripts/backup-db.sh to report backup failures.
# Treat as a secret: anyone who knows the name can read and post to it.
# Generate a long random name, subscribe to it in the ntfy mobile app.
NTFY_TOPIC=change-this-to-a-long-random-topic-name